#!/usr/bin/env ruby
# frozen_string_literal: true

# Kullanım: ruby bin/kontrol
# Testleri çalıştırır ve lib/ içinde yasaklı kalıpları arar.
# Temizse "KONTROL YESIL" yazar, exit 0. Sorun varsa STDERR + exit 2.

require "open3"
require "rbconfig"

Encoding.default_external = Encoding::UTF_8
STDOUT.sync = true
STDERR.sync = true

KOK = File.expand_path("..", __dir__)
Dir.chdir(KOK)

sorunlar = []

# 1) Testler
test_dosyalari = Dir.glob("test/**/*_test.rb").sort
if test_dosyalari.empty?
  sorunlar << "TEST: test/ altında *_test.rb bulunamadı."
else
  test_dosyalari.each do |dosya|
    cikti, durum = Open3.capture2e(RbConfig.ruby, "-W0", "-Ilib", "-Itest", dosya)
    next if durum.success?

    sorunlar << "TEST KIRMIZI: #{dosya} (çıkış kodu #{durum.exitstatus})\n#{cikti.force_encoding('UTF-8')}"
  end
end

# 2) lib/ statik taraması
YASAKLAR = {
  /\bmethod_missing\b/ => "method_missing yasak",
  /\brespond_to_missing\?/ => "respond_to_missing? yasak",
  /^\s*class\s+(::)?(Integer|String|Object|Array|Hash|Kernel|Numeric|Symbol|BasicObject|Module|Class)\b/ =>
    "mevcut sınıfa monkey patch yasak",
  /^\s*module\s+(::)?(Kernel|Comparable|Enumerable)\b/ => "mevcut modüle monkey patch yasak",
  /\b(Integer|String|Object|Array|Hash|Kernel)\.(class_eval|class_exec|module_eval|send\(:define_method)/ =>
    "mevcut sınıfa class_eval/define_method ile yama yasak",
  /\brefine\b/ => "refine yasak",
  /\busing\b\s+[A-Z]/ => "refinement (using) yasak",
  /\b(gets|STDIN|\$stdin)\b/ => "kullanıcıdan girdi okuma (gets/STDIN) yasak",
  /\b(\d+\.\d+|to_f|Float|fdiv)\b/ => "float/yüzde hesabı yasak; tamsayı karşılaştırması kullan"
}.freeze

lib_dosyalari = Dir.glob("lib/**/*.rb").sort
if lib_dosyalari.empty?
  sorunlar << "LIB: lib/ altında .rb dosyası yok (lib/ogrenci.rb ve lib/devamsizlik_kontrol.rb gerekli)."
else
  %w[lib/ogrenci.rb lib/devamsizlik_kontrol.rb].each do |gerekli|
    sorunlar << "LIB: #{gerekli} eksik." unless File.file?(gerekli)
  end

  lib_dosyalari.each do |dosya|
    File.readlines(dosya, encoding: "UTF-8").each_with_index do |satir, i|
      kod = satir.sub(/(^|\s)#.*$/, "") # yorumları atla
      next if kod.strip.empty?

      YASAKLAR.each do |kalip, mesaj|
        sorunlar << "YASAK: #{dosya}:#{i + 1}: #{mesaj}\n    #{satir.strip}" if kod.match?(kalip)
      end
    end
  end
end

if sorunlar.empty?
  puts "KONTROL YESIL"
  exit 0
else
  STDERR.puts "KONTROL KIRMIZI — #{sorunlar.size} sorun:"
  sorunlar.each { |s| STDERR.puts "", s }
  STDERR.puts "", "AGENTS.md kurallarına uy, düzelt ve `ruby bin/kontrol` komutunu tekrar çalıştır."
  exit 2
end
